# frozen_string_literal: true

desc 'Generate syscall arguments from Linux:include/linux/syscalls.h'
task :sys_arg do
  content = File.binread('tasks/syscalls.h') + File.binread('tasks/syscalls_complement.h')

  # The CONFIG_ARCH_SPLIT_ARG64 prototypes label a single u64 argument as two 32-bit words; seccomp
  # always exposes 64-bit argument slots, so keep the unified (#else) prototype instead.
  content.gsub!(/^#if defined\(CONFIG_ARCH_SPLIT_ARG64\).*?^#else\n/m, '')

  # How many bits of a 64-bit argument slot the kernel reads for each non-pointer parameter type
  # (+const+ and +__user+ stripped); a pointer is always 64. The kernel casts each slot to the
  # declared type, so a narrower parameter ignores the slot's upper bits.
  bits = {
    64 => ['long', 'unsigned long', 'size_t', 'loff_t', 'off_t', 'u64', 'aio_context_t', 'old_sigset_t',
           'cap_user_data_t', 'cap_user_header_t', '__sighandler_t'],
    32 => ['int', 'unsigned int', 'unsigned', 'u32', '__u32', '__s32', 'uint32_t', 'pid_t', 'uid_t', 'gid_t',
           'qid_t', 'clockid_t', 'timer_t', 'mqd_t', 'key_t', 'key_serial_t', 'rwf_t'],
    16 => %w[umode_t old_uid_t old_gid_t]
  }.flat_map { |width, types| types.map { |type| [type, width] } }.to_h

  def error(name, args, msg)
    puts "[ERROR] #{msg}\n\t#{name}(#{args})"
  end

  # The +[name, type]+ of each parameter, or +nil+ when a parameter is unnamed.
  def parse_args(args)
    return [] if args == 'void'

    args = args.gsub(/\s+/m, ' ')
    args = args.split(', ').map { |c| c.match(/\A(.*?) *(\w+)\z/)&.captures&.reverse }
    return nil unless args.all?
    return nil if %w[int long].intersect?(args.map(&:first))

    args
  end

  # The bits the kernel reads of a parameter of +type+, or +nil+ when +type+ is not in +bits+.
  width = lambda do |type|
    next 64 if type.include?('*')

    type = type.gsub(/\b(?:const|__user)\b/, '').squeeze(' ').strip
    type.start_with?('enum ') ? 32 : bits[type]
  end

  parse_failed = {}
  proto = content.scan(/^asmlinkage long sys_(\w+)\(([^)]+)\);/m).each_with_object({}) do |(name, args), hash|
    next if name == 'sigsuspend' # XXX: there are two implementations, don't know which one should be used
    next error(name, args, 'dup') if hash.key?(name)

    parse_args(args).tap do |res|
      next parse_failed[name] = args if res.nil?

      widths = res.map { |_arg, type| width.call(type) }
      next error(name, args, 'unknown argument type') unless widths.all?

      hash[name] = res.map(&:first).zip(widths)
    end
  end
  parse_failed.each do |name, args|
    error(name, args, 'parse args faield') unless proto.key?(name)
  end
  entries = proto.map do |key, value|
    value.empty? ? "  #{key}: {}" : "  #{key}: { #{value.map { |arg, w| "#{arg}: #{w}" }.join(', ')} }"
  end
  File.binwrite(File.join('lib', 'seccomp-tools', 'consts', 'sys_arg.rb'), <<~RUBY)
    # frozen_string_literal: true

    # Generated by `bundle exec rake sys_arg`
    # Syscall name => { argument name => bits of its 64-bit slot the kernel reads }

    {
    #{entries.join(",\n")}
    }
  RUBY
end
